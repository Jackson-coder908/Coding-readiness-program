#include <stdio.h>

int main()
{
    int rows, num = 1;    // num tracks current number
    printf("Enter number of rows: ");
    scanf("%d", &rows);

    for (int i = 1; i <= rows; i++)  // loop for rows
    {
        for (int j = 1; j <= i; j++)  // loop for columns
        {
            printf("%d ", num);
            num++;
        }
        printf("\n");
    }

    return 0;
}
