double myPow(double x, int n) {
    long exp = n;  // use long to handle INT_MIN safely

    if (exp < 0) {
        x = 1.0 / x;
        exp = -exp;
    }

    double result = 1.0;

    while (exp > 0) {
        if (exp % 2 == 1)       // odd exponent
            result *= x;
        x *= x;                 // square the base
        exp /= 2;               // halve the exponent
    }

    return result;
}
