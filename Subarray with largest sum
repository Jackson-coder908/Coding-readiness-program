#include <stdio.h>



int maxSubArray(int* nums, int n) {

    int maxSum = nums[0];

    int currentSum = nums[0];



    for (int i = 1; i < n; i++) {

        if (currentSum < 0) {

            currentSum = nums[i];

        } else {

            currentSum += nums[i];

        }



        if (currentSum > maxSum) {

            maxSum = currentSum;

        }

    }

    return maxSum;

}



int main() {

    int n;



    printf("Enter the number of elements: ");

    scanf("%d", &n);



    int nums[n];



    printf("Enter %d elements: ", n);

    for (int i = 0; i < n; i++) {

        scanf("%d", &nums[i]);

    }



    int ans = maxSubArray(nums, n);

    printf("The largest subarray sum is: %d\n", ans);



    return 0;

}

 
