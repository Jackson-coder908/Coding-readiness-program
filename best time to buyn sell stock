#include <stdio.h>

int maxProfit(int *prices, int n) {
    int min_price = prices[0];
    int max_profit = 0;

    for (int i = 1; i < n; i++) {
        if (prices[i] < min_price)
            min_price = prices[i];
        else if (prices[i] - min_price > max_profit)
            max_profit = prices[i] - min_price;
    }

    return max_profit;
}

int main() {
    int n;

    printf("Enter number of days: ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Invalid input.\n");
        return 1;
    }

    int prices[n];

    printf("Enter prices for %d days:\n", n);
    for (int i = 0; i < n; i++) {
        printf("Day %d: ", i + 1);
        scanf("%d", &prices[i]);
    }

    int result = maxProfit(prices, n);

    if (result == 0)
        printf("\nNo profit possible. Max Profit = 0\n");
    else
        printf("\nMaximum Profit = %d\n", result);

    return 0;
}
