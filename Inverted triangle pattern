#include <stdio.h>

int main()
{
    int rows;

    printf("Enter number of rows: ");
    scanf("%d", &rows);

    for (int i = rows; i >= 1; i--) // starts from rows and counts back to 1
    {
        for (int j = 0; j < rows - i; j++) // prints spaces
        {
            printf(" ");
        }
        for (int k = 0; k < 2 * i - 1; k++) // prints *
        {
            printf("*");
        }

        printf("\n");
    }

    return 0;
}
