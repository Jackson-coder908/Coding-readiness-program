#include <stdio.h>
#include <math.h>

void decimalToBinary(int n) {
    if (n == 0) {
        printf("0");
        return;
    }
    int binary[32], i = 0;
    while (n > 0) {
        binary[i++] = n % 2;
        n /= 2;
    }
    for (int j = i - 1; j >= 0; j--) {
        printf("%d", binary[j]);
    }
    printf("\n");
}

int binaryToDecimal(long bin) {
    int dec = 0, base = 1;
    while (bin > 0) {
        int rem = bin % 10;
        dec += rem * base;
        bin /= 10;
        base *= 2;
    }
    return dec;
}

int main() {
    int dec;
    long bin;

    printf("Enter decimal: ");
    scanf("%d", &dec);
    printf("Binary: ");
    decimalToBinary(dec);

    printf("Enter binary: ");
    scanf("%ld", &bin);
    printf("Decimal: %d\n", binaryToDecimal(bin));

    return 0;
} 
